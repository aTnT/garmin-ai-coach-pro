// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Users and Authentication
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Profile data
  age          Int?
  gender       Gender?
  weight       Float?    // kg
  role         UserRole  @default(ATHLETE)

  // Relations
  metrics       Metric[]
  workouts      Workout[]
  plans         TrainingPlan[]
  conversations Conversation[]
  oauthTokens   OAuthToken[]
  subscription  Subscription?

  // Team relationships
  coaching      TeamMembership[] @relation("CoachMemberships")
  athletes      TeamMembership[] @relation("AthleteMemberships")
  sentInvites   TeamInvite[]     @relation("CoachInvites")
}

// Training Metrics
model Metric {
  id        String     @id @default(cuid())
  userId    String
  date      DateTime
  type      MetricType
  value     Float
  unit      String?
  metadata  Json?
  createdAt DateTime   @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, type, date])
}

// Workouts
model Workout {
  id          String      @id @default(cuid())
  userId      String
  planId      String?
  date        DateTime
  sport       Sport
  type        WorkoutType
  name        String
  duration    Int?        // minutes
  distance    Float?      // km
  structure   Json        // Detailed workout structure
  completed   Boolean     @default(false)
  completedAt DateTime?
  notes       String?
  createdAt   DateTime    @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        TrainingPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

// Training Plans
model TrainingPlan {
  id          String     @id @default(cuid())
  userId      String
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  sport       Sport
  goal        String?
  weeks       Int
  planData    Json       // Structured plan data
  status      PlanStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workouts    Workout[]
  adaptations PlanAdaptation[]
}

// Plan Adaptations (automatic adjustments based on readiness/performance)
model PlanAdaptation {
  id          String   @id @default(cuid())
  planId      String
  userId      String   // For easy querying

  // Trigger info
  triggerType String   // LOW_READINESS, MISSED_WORKOUTS, etc.
  severity    String   // low, medium, high, critical
  detected    DateTime

  // Recommendation
  confidence  Int      // 0-100
  urgency     String   // low, medium, high, critical
  reasoning   String   @db.Text
  modifications Json   // Array of PlanModification objects
  alternatives Json?   // Alternative approaches

  // Status
  status      AdaptationStatus @default(PENDING)
  appliedAt   DateTime?
  appliedBy   String?  // userId who approved
  rejectedAt  DateTime?
  rejectedReason String?

  // Rollback support
  previousPlanData Json? // Backup of plan before modification
  rollbackAt  DateTime?

  createdAt   DateTime @default(now())

  plan TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, createdAt])
  @@index([userId, createdAt])
  @@index([status])
}

// HITL Sessions (Human-in-the-Loop questioning)
model HITLSession {
  id             String   @id @default(cuid())
  userId         String
  workflowType   String   // plan_generation, plan_refinement, etc.
  status         String   // active, completed, abandoned

  // Questions and responses
  questions      Json     // Array of HITLQuestion objects
  responses      Json     // Array of HITLResponse objects
  currentQuestionIndex Int @default(0)

  // Context
  initialContext   Json   // What we started with
  gatheredContext  Json   // What we collected

  // Metadata
  createdAt      DateTime @default(now())
  completedAt    DateTime?
  expiresAt      DateTime

  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

// Notifications
model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        NotificationType
  priority    NotificationPriority
  title       String
  message     String   @db.Text
  actionUrl   String?
  actionLabel String?
  metadata    Json?
  read        Boolean  @default(false)
  readAt      DateTime?
  createdAt   DateTime @default(now())
  expiresAt   DateTime?

  @@index([userId, read, createdAt])
  @@index([expiresAt])
}

// AI Coaching Conversations
model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, createdAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// OAuth Tokens for external integrations
model OAuthToken {
  id           String   @id @default(cuid())
  userId       String
  provider     String   // "GARMIN", "STRAVA", etc.
  accessToken  String   @db.Text
  refreshToken String?  @db.Text
  expiresAt    DateTime?
  scope        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

// Subscriptions and Billing
model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)

  // Stripe IDs
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?

  // Billing cycle
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)

  // Usage tracking (for FREE tier limits)
  garminSyncsThisMonth Int                @default(0)
  lastSyncReset        DateTime           @default(now())

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

// Team Management
model TeamMembership {
  id        String   @id @default(cuid())
  coachId   String
  athleteId String

  // Permissions
  canViewMetrics   Boolean @default(true)
  canViewWorkouts  Boolean @default(true)
  canViewPlans     Boolean @default(true)
  canEditPlans     Boolean @default(false)

  // Metadata
  joinedAt  DateTime @default(now())
  notes     String?

  coach   User @relation("CoachMemberships", fields: [coachId], references: [id], onDelete: Cascade)
  athlete User @relation("AthleteMemberships", fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([coachId, athleteId])
  @@index([coachId])
  @@index([athleteId])
}

model TeamInvite {
  id          String       @id @default(cuid())
  coachId     String
  athleteEmail String
  status      InviteStatus @default(PENDING)
  message     String?

  createdAt   DateTime @default(now())
  respondedAt DateTime?
  expiresAt   DateTime // 7 days from creation

  coach User @relation("CoachInvites", fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId])
  @@index([athleteEmail])
  @@index([status])
}

// Audit Logs for security and compliance
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  // Null for system actions
  action    String   // Action performed (e.g., "USER_LOGIN", "DATA_ACCESS", "PLAN_DELETED")
  resource  String?  // Resource affected (e.g., "plan:123", "user:456")
  ipAddress String?
  userAgent String?
  metadata  Json?    // Additional context
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([resource])
}

// Enums
enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Sport {
  RUNNING
  CYCLING
  SWIMMING
  TRIATHLON
  OTHER
}

enum MetricType {
  VO2MAX
  HRV
  RESTING_HR
  MAX_HR
  FTP
  TRAINING_LOAD
  RECOVERY_TIME
  READINESS_SCORE
  SLEEP_HOURS
  STRESS_LEVEL
  WORKOUT_QUALITY
}

enum WorkoutType {
  EASY
  TEMPO
  INTERVAL
  LONG
  RECOVERY
  RACE
  STRENGTH
}

enum PlanStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum SubscriptionTier {
  FREE
  PREMIUM
  TEAM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
}

enum UserRole {
  ATHLETE
  COACH
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum AdaptationStatus {
  PENDING     // Recommended, awaiting approval
  APPLIED     // Approved and applied to plan
  REJECTED    // User/coach declined
  SUPERSEDED  // Replaced by newer adaptation
}

enum NotificationType {
  ADAPTATION_RECOMMENDED
  ADAPTATION_APPLIED
  READINESS_CRITICAL
  READINESS_IMPROVED
  TEAM_INVITE
  WORKOUT_REMINDER
  SUBSCRIPTION_UPDATED
  PLAN_COMPLETED
  MILESTONE_ACHIEVED
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
